---
export interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'RUA Visual · Diseño gráfico artesanal · El Artesano Web',
  description = 'Diseño gráfico artesanal para marcas que quieren comunicar con identidad. Logos, templates, infografías. Argentina · Costa Rica.',
  image = '/img/og-image.webp',
} = Astro.props;

const siteUrl = 'https://www.elartesanoweb.com';
const canonicalURL = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = new URL(image, siteUrl).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'RUA Visual',
  description,
  url: canonicalURL,
  image: ogImage,
  provider: {
    '@type': 'Organization',
    name: 'El Artesano Web',
    url: siteUrl,
  },
  areaServed: ['Argentina', 'Costa Rica'],
  serviceType: ['Diseño gráfico', 'Identidad de marca', 'Logotipos', 'Infografías'],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#1a1a1a" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/img/faviconRua.svg" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="RUA Visual · Diseño gráfico artesanal" />
    <meta property="og:site_name" content="El Artesano Web" />
    <meta property="og:locale" content="es_AR" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="RUA Visual · Diseño gráfico artesanal" />

    <!-- JSON-LD -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/globalRua.css';
</style>
