---
export const prerender = true;
import Navbar from "../../components/Navbar.jsx";
// import Hero from "../../components/Hero.astro";
import Hero from "../../components/Hero.astro";
import About from "../../components/About.astro";
import Projects from "../../components/Projects.astro";
import Services from "../../components/Services.jsx";
import Contact from "../../components/Contact.jsx";
import Footer from "../../components/Footer.jsx";
import Layout from "../../layouts/Layout.astro";
import { languages } from "../../i18n/data.js";

const { hero, about, nav, projects, services, contact, footer } = languages.en;
---

<Layout
    title="El Artesano Web | Web Development | Argentina & Costa Rica"
    description="High-performance web development with Astro and React. Web services and maintenance for Argentina, Costa Rica, and the world."
>
    <Navbar client:load lang="en" texts={nav} />
    <main>
        <Hero content={hero} />
        <About content={about} />
        <Projects content={projects} />
        <Services client:visible content={services} />
        <Contact client:visible content={contact} />
    </main>
    <Footer content={footer} links={nav.navLinks} />
</Layout>
