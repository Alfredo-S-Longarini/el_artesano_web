---
// src/pages/utilidades/index.astro
import Layout from "../../layouts/Layout.astro";
import UtilitiesNavbar from "../../components/shared/UtilitiesNavbar.jsx";
import Footer from "../../components/Footer.jsx"; // Asegúrate que esta ruta sea correcta

const tools = [
  {
    title: "Link WhatsApp",
    description:
      "Genera enlaces directos con mensajes personalizados para tus clientes.",
    link: "/utilidades/whatsapp",
    icon: "💬",
    status: "active",
  },
  {
    title: "Generador QR",
    description: "Crea códigos QR personalizados con los colores de tu marca.",
    link: "/utilidades/qr",
    icon: "📱",
    status: "active",
  },
  {
    title: "Acortador URL",
    description: "Simplifica enlaces largos para compartir en redes sociales.",
    link: "/utilidades/shorturl",
    icon: "✂️",
    status: "active",
  },
];
---

<Layout
  title="Utilidades | El Artesano Web"
  description="Herramientas gratuitas para desarrolladores y emprendedores."
>
  {/* Navbar Específico */}
  <UtilitiesNavbar client:load />

  {/* Contenedor Principal con estilos de Projects.astro */}
  <main class="bg-[#1a1510] min-h-screen text-[#EFEFEF]">
    <section class="py-24 container mx-auto px-6">
      {/* Encabezado */}
      <div class="mb-16 text-center reveal animate-hero">
        <h1
          class="text-4xl md:text-5xl font-serif font-bold mb-4 text-[#EFEFEF]"
        >
          Taller de Utilidades
        </h1>
        <p class="text-stone-400 font-sans max-w-2xl mx-auto text-lg">
          Pequeñas herramientas forjadas para resolver problemas cotidianos.
        </p>
      </div>

      {/* Grid de Herramientas */}
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {
          tools.map((tool, index) => (
            <a
              href={tool.link}
              class:list={[
                "group block p-8 rounded-xl border transition-all duration-300 reveal",
                {
                  "bg-[#231e19] border-white/5 hover:border-amber-500/50 hover:-translate-y-2 hover:shadow-2xl":
                    tool.status === "active",
                  "bg-[#231e19]/50 border-white/5 border-dashed cursor-not-allowed opacity-70":
                    tool.status === "soon",
                },
              ]}
              style={`transition-delay: ${(index + 1) * 100}ms`}
            >
              <div class="flex justify-between items-start mb-4">
                <span class="text-4xl group-hover:scale-110 transition-transform duration-300">
                  {tool.icon}
                </span>
                {tool.status === "soon" && (
                  <span class="text-xs bg-white/10 text-stone-400 px-2 py-1 rounded-full">
                    Próximamente
                  </span>
                )}
              </div>

              <h3 class="text-2xl font-bold text-[#EFEFEF] mb-3 font-serif group-hover:text-amber-500 transition-colors">
                {tool.title}
              </h3>
              <p class="text-stone-400 font-sans leading-relaxed text-sm">
                {tool.description}
              </p>

              {tool.status === "active" && (
                <span class="inline-flex items-center gap-2 mt-6 text-amber-500 font-bold text-sm uppercase tracking-wider">
                  Abrir herramienta
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <line x1="5" y1="12" x2="19" y2="12" />
                    <polyline points="12 5 19 12 12 19" />
                  </svg>
                </span>
              )}
            </a>
          ))
        }
      </div>
    </section>
  </main>

  <Footer />
</Layout>
