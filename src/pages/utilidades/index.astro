---
// src/pages/utilidades/index.astro
export const prerender = true;
import Layout from "../../layouts/Layout.astro";
import UtilitiesNavbar from "../../components/shared/UtilitiesNavbar.jsx";
import Footer from "../../components/Footer.jsx";

const tools = [
  {
    title: "Generador de Links",
    description: "Crea enlaces inteligentes para WhatsApp, Telegram y Email sin fricciones.",
    link: "/utilidades/links",
    icon: "message-square", // Nombre de referencia para un icono
    status: "active"
  },
  {
    title: "Generador QR",
    description: "Crea códigos QR de alta resolución personalizados con tu identidad de marca.",
    link: "/utilidades/qr",
    icon: "qr-code",
    status: "active",
  },
  {
    title: "Acortador URL",
    description: "Simplifica y analiza tus enlaces largos para compartirlos en cualquier plataforma.",
    link: "/utilidades/shorturl",
    icon: "link",
    status: "active",
  },
];
---

<Layout title="Taller de Utilidades | El Artesano Web">
  <UtilitiesNavbar client:load />

  <main class="relative bg-[#1a1510] min-h-screen text-[#EFEFEF] overflow-hidden">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1000px] h-[600px] bg-amber-500/5 blur-[120px] rounded-full pointer-events-none"></div>

    <section class="relative py-24 container mx-auto px-6">
      {/* Encabezado con más aire */}
      <div class="mb-20 text-center max-w-3xl mx-auto">
        <span class="text-amber-500 font-serif italic text-sm mb-4 block tracking-widest uppercase">Herramientas de Precisión</span>
        <h1 class="text-5xl md:text-6xl font-sans font-black mb-6 tracking-tight">
          Taller de <span class="text-transparent bg-clip-text bg-linear-to-r from-[#EFEFEF] to-stone-500">Utilidades</span>
        </h1>
        <p class="text-stone-400 font-serif text-xl leading-relaxed">
          Pequeñas piezas de software forjadas a mano para elevar tu flujo de trabajo diario.
        </p>
      </div>

      {/* Grid de Herramientas */}
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {tools.map((tool, index) => (
          <a
            href={tool.link}
            class:list={[
              "group relative overflow-hidden p-8 rounded-2xl border transition-all duration-500",
              {
                "bg-[#231e19]/40 border-white/5 hover:border-amber-500/40 hover:bg-[#2a241e]": tool.status === "active",
                "bg-transparent border-dashed border-white/10 opacity-60 cursor-not-allowed": tool.status === "soon",
              }
            ]}
          >
            <div class="absolute top-0 right-0 p-4 opacity-5 group-hover:opacity-10 transition-opacity">
               <span class="text-8xl font-black italic">0{index + 1}</span>
            </div>

            <div class="relative z-10">
              <div class="w-12 h-12 flex items-center justify-center rounded-lg bg-amber-500/10 text-amber-500 mb-6 group-hover:scale-110 group-hover:bg-amber-500 group-hover:text-[#1a1510] transition-all duration-300">
                {/* Aquí puedes usar un componente de icono real */}
                <div class="w-6 h-6 border-2 border-current rounded-sm"></div> 
              </div>

              <h3 class="text-2xl font-bold mb-3 font-sans">
                {tool.title}
              </h3>
              <p class="text-stone-400 font-serif text-[15px] leading-relaxed mb-8">
                {tool.description}
              </p>

              <div class="flex items-center gap-2 text-amber-500 text-xs font-bold tracking-[0.2em] uppercase">
                <span class="h-px w-8 bg-amber-500/30 group-hover:w-12 transition-all"></span>
                {tool.status === "active" ? "Iniciar Herramienta" : "En la forja"}
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  /* Animación de entrada suave */
  section {
    animation: fadeIn 0.8s ease-out;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
