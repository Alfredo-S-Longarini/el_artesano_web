---
export const prerender = true;
import Layout from "../../layouts/Layout.astro";
import UtilitiesNavbar from "../../components/shared/UtilitiesNavbar.jsx";
import QrGenerator from "../../components/tools/QrGenerator.jsx";
import Footer from "../../components/Footer.jsx";
---

<Layout
  title="Generador de Códigos QR | El Artesano Web"
  description="Crea códigos QR personalizados gratis con colores y logo. Herramienta online sin registro."
>
  <UtilitiesNavbar client:load />

  <main class="bg-[#1a1510] min-h-screen text-[#EFEFEF]">
    <section class="py-24 container mx-auto px-6">
      {/* Encabezado */}
      <div class="text-center mb-12 reveal animate-hero">
        <a
          href="/utilidades"
          class="text-stone-400 hover:text-amber-500 mb-6 inline-flex items-center gap-2 text-sm transition-colors"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><line x1="19" y1="12" x2="5" y2="12"></line><polyline
              points="12 19 5 12 12 5"></polyline></svg
          >
          Volver al taller
        </a>
        <h1
          class="text-amber-500 font-serif text-3xl md:text-5xl font-bold mb-4"
        >
          Generador de QR Personalizado
        </h1>
        <p class="text-stone-300 text-lg max-w-2xl mx-auto">
          Diseña códigos QR únicos para tu marca. Ajusta colores e inserta tu
          logotipo.
        </p>
      </div>

      {/* Componente Interactivo */}
      <div class="reveal delay-300">
        <QrGenerator client:load />
      </div>

      {/* Contenido SEO */}
      <article class="max-w-3xl mx-auto mt-20 prose prose-invert prose-lg">
        <h2 class="text-2xl font-bold font-serif text-amber-500">
          ¿Para qué sirve un QR personalizado?
        </h2>
        <p class="text-stone-400">
          A diferencia de los códigos en blanco y negro estándar, un QR
          personalizado refuerza tu identidad de marca. Es ideal para tarjetas
          de presentación, menús de restaurantes, packaging de productos o
          flyers promocionales.
        </p>
        <ul class="text-stone-400 list-disc pl-5 space-y-2">
          <li>Redirige a tu sitio web o portafolio.</li>
          <li>Comparte tu red WiFi sin dictar contraseñas.</li>
          <li>Facilita pagos o contacto por WhatsApp.</li>
        </ul>
      </article>
    </section>
  </main>

  <Footer />
</Layout>
