---
export const prerender = true;
import Navbar from "../components/Navbar.jsx";
// import Hero from "../components/Hero.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Projects from "../components/Projects.astro";
import Services from "../components/Services.jsx";
import Contact from "../components/Contact.jsx";
import Footer from "../components/Footer.jsx";
import Layout from "../layouts/Layout.astro";
import UtilitiesPromo from "../components/UtilitiesPromo.astro";
import Testimonials from "../components/Testimonials.astro";
---

<Layout
  title="El Artesano Web | Argentina & Costa Rica | Desarrollador Web Freelance"
  description="Creación de páginas web de alto rendimiento con Astro y React. Servicios de desarrollo web y mantenimiento para Argentina, Costa Rica y el exterior."
>
  <Navbar client:load />
  <main>
    <Hero />
    <About />
    <Projects />
    <!-- <UtilitiesPromo /> -->
    <Services client:visible />
    <Testimonials />
    <Contact client:visible />
  </main>
  <Footer />
</Layout>
