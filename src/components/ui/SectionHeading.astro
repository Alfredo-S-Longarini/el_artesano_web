---
// Encabezado de sección: etiqueta, título en Lora y bajada opcional.
interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  intro?: string;
  align?: "left" | "center";
}

const { id, eyebrow, title, intro, align = "left" } = Astro.props;
---

<header class:list={["mb-12 max-w-2xl", align === "center" && "mx-auto text-center"]}>
  {eyebrow && <p class="mb-3 text-xs font-semibold uppercase tracking-[0.25em] text-gold">{eyebrow}</p>}
  <h2 id={id} class="text-3xl font-semibold leading-tight md:text-4xl lg:text-5xl">{title}</h2>
  {intro && <p class="mt-4 text-lg leading-relaxed text-muted">{intro}</p>}
</header>
