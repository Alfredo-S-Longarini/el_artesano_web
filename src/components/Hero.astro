---
// 1. Importaciones de Astro
import { Image } from "astro:assets";

// 2. Importar las imágenes locales para optimización
import woodBg from "../assets/wood-bg.webp";
import characterImg from "../assets/character.webp";
---

<section
  id="home"
  class="relative w-full h-auto overflow-hidden bg-[#2C241B]"
>
  {/* --- FONDO OPTIMIZADO --- */}
  <div class="absolute inset-0 z-0">
    <Image
      src={woodBg}
      alt="Fondo de madera oscura texturizada"
      class="w-full h-full object-cover opacity-60 animate-bg-slow"
      quality="high"
      loading="eager"
    />

    {/* Overlay oscuro */}
    <div class="absolute inset-0 bg-black/40"></div>
  </div>

  {/* --- CONTENEDOR PRINCIPAL --- */}
  <div
    class="relative z-10 container mx-auto px-6 grid grid-cols-1 md:grid-cols-2 gap-8 pt-32 md:pt-40 pb-0"
  >
    {/* Columna Izquierda: Texto */}
    <div class="text-left space-y-6 reveal-left pb-12 md:pb-20">
      <h1
        class="text-4xl md:text-5xl lg:text-6xl font-sans text-[#EFEFEF] leading-tight"
      >
        Sitios web a medida, <br class="hidden md:block" />
        diseñados desde cero y centrados en el usuario.
      </h1>

      <p class="text-lg text-stone-300 max-w-lg font-serif">
        Diseño y desarrollo sitios web rápidos, modernos y adaptados a cada etapa de tu negocio — ya sea que estés empezando, quieras tener presencia online o necesites renovar lo que ya tenés.
      </p>

      {/* --- ZONA DE ACCIÓN (Modificada) --- */}
      <div class="flex flex-col items-start gap-4 pt-6">
        {/* Grupo de Botones: En fila en PC, columna en Móvil */}
        <div class="flex flex-col sm:flex-row gap-4 w-full sm:w-auto">
          {/* 1. Botón Principal (Proyectos) */}
          <a
            id="btnProyectos"
            href="#contacto"
            class="group relative px-4 py-3.5 bg-[#5D4037] text-[#EFEFEF] font-serif text-lg rounded shadow-[0_10px_20px_rgba(93,64,55,0.4)] hover:shadow-[0_15px_25px_rgba(93,64,55,0.6)] hover:bg-[#4E342E] transition-all duration-300 flex items-center justify-center gap-3 transform hover:-translate-y-1 text-center"
          >
            <span>Hablemos de tu proyecto</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5 transform group-hover:translate-x-1 transition-transform"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>

          {/* 2. Botón Secundario (Proyectos) - NUEVO */}
          <a
            href="#proyectos"
            class="group px-8 py-3.5 border border-amber-500/50 text-amber-500 font-serif text-lg rounded hover:bg-amber-500 hover:text-[#2C241B] transition-all duration-300 flex items-center justify-center gap-3 text-center"
          >
            {/* Icono de Herramienta */}
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="transform group-hover:rotate-12 transition-transform"
              ><path
                d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"
              ></path></svg
            >
            <span>Ver trabajos realizados</span>
          </a>
        </div>

        {/* Texto Terciario */}
        <p class="text-stone-400 text-sm font-sans mt-2">
          o descubre mis <a
            href="#servicios"
            class="text-amber-500 hover:text-amber-400 underline decoration-amber-500/30 underline-offset-4 transition-colors"
            >Servicios y Soluciones</a
          >
        </p>
      </div>
    </div>

    {/* Columna Derecha: Imagen del Personaje */}
    <div class="flex justify-center md:justify-end mt-8 md:mt-0 reveal">
      <Image
        src={characterImg}
        alt="Ilustración de desarrollador web estilo artesano"
        class="w-3/4 md:w-full max-w-md object-contain drop-shadow-2xl"
        loading="eager"
      />
    </div>
  </div>
</section>
