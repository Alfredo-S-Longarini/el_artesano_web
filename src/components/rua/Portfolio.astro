---
// src/components/Portfolio.astro
import PortfolioCard from "./PortfolioCard.astro";

const projects = [
  {
    category: "Flyer",
    title: "Flyer de servicios · Desarrollo Web",
    description:
      "Pieza promocional para estudio de desarrollo web. Fondo textura madera, íconos de servicios y datos de contacto.",
    tags: ["Flyer", "Branding", "Marketing Digital"],
    color: "#c89f53",
    aspect: "3/4",
    images: ["/img/ruaProjects/proy-aw.png"],
  },
  {
    category: "Infografía",
    title: "Infografía educativa · Compost Casero",
    description:
      "Guía visual paso a paso sobre compostaje doméstico. Incluye materiales reciclables y proceso completo en 5 etapas.",
    tags: ["Infografía", "Educación", "Medio Ambiente"],
    color: "#7a9e4e",
    aspect: "3/4",
    images: ["/img/ruaProjects/proy-compost.png"],
  },
  {
    category: "Invitación",
    title: "Invitación digital · Boda elegante",
    description:
      "Invitación de boda con countdown, itinerario del evento, código de vestimenta, mapa, información de regalo y confirmación de asistencia.",
    tags: ["Boda", "Invitación Digital", "Eventos"],
    color: "#b8a47a",
    aspect: "3/4",
    images: [
      "/img/ruaProjects/proy-boda1.png",
      "/img/ruaProjects/proy-boda2.png",
      "/img/ruaProjects/proy-boda3.png",
      "/img/ruaProjects/proy-boda4.png",
      "/img/ruaProjects/proy-boda5.png",
    ],
  },
  {
    category: "Branding",
    title: "Identidad visual completa · Dulce Violeta",
    description:
      "Branding integral para pastelería artesanal: logotipo en versión clara y oscura, y pack de 4 íconos para historias destacadas de Instagram (Contacto, Pastelería, Repostería, Clientes). Estética watercolor con paleta violeta y detalles dorados.",
    tags: ["Logo", "Branding", "Instagram", "Highlights", "Pastelería"],
    color: "#9b7ec8",
    aspect: "1/1",
    images: [
      "/img/ruaProjects/dv/proy-dv1.png",
      "/img/ruaProjects/dv/proy-dv2.png",
      "/img/ruaProjects/dv/proy-dv3.png",
      "/img/ruaProjects/dv/proy-dv4.png",
      "/img/ruaProjects/dv/proy-dv5.png",
      "/img/ruaProjects/dv/proy-dv6.png",
      "/img/ruaProjects/dv/proy-dv7.png",
    ],
  },
  {
    category: "Invitación",
    title: "Invitación de cumpleaños · 80 años",
    description:
      "Invitación estilo retro años 70 para celebración de 80 años. Incluye itinerario, código de vestimenta, foto del evento en vivo y detalles de ubicación. Paleta dorada, azul marino y terracota con tipografía vintage.",
    tags: ["Cumpleaños", "Invitación", "Retro", "Evento"],
    color: "#c9973a",
    aspect: "3/4",
    images: ["/img/ruaProjects/proy-cumple.png"],
  },
  {
    category: "Redes Sociales",
    title: "Manejo de redes · CAPEAC",
    description:
      "Gestión integral de redes sociales para empresa de capacitación vial argentina. Incluye diseño de carousels educativos, flyers de cursos y fechas, artes para certificaciones y plantillas reutilizables. Paleta azul institucional con tipografía bold y estética profesional.",
    tags: ["Community Manager", "Instagram", "Diseño", "Educación Vial"],
    color: "#1a5fb4",
    aspect: "4/5",
    images: ["/img/ruaProjects/capeac/design-capeac1.png", "/img/ruaProjects/capeac/design-capeac2.png", "/img/ruaProjects/capeac/design-capeac3.png", "/img/ruaProjects/capeac/design-capeac4.png", "/img/ruaProjects/capeac/design-capeac5.png", "/img/ruaProjects/capeac/design-capeac6.png"],
  },
];
---

<section
  id="portafolio"
  class="bg-cream py-[clamp(80px,10vw,140px)] px-5 sm:px-10 lg:px-20"
  aria-labelledby="portfolio-heading"
>
  <div class="max-w-content mx-auto">
    <!-- Header -->
    <div class="flex justify-between items-end flex-wrap gap-6 mb-16">
      <div>
        <span class="section-label">Portafolio</span>
        <h2
          id="portfolio-heading"
          class="font-serif font-normal leading-[1.1] text-brown max-w-[480px]"
          style="font-size: clamp(36px,5vw,60px)"
        >
          Proyectos que <em class="italic">marcan la diferencia</em>
        </h2>
      </div>
      <p
        class="font-sans text-[14px] text-brown/60 leading-[1.7] max-w-[320px]"
      >
        Cada pieza nace de una escucha profunda.<br />Tu idea, nuestro oficio.
      </p>
    </div>

    <!-- Grid -->
    <ul
      class="list-none grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-2 xl:grid-cols-4 gap-7"
      role="list"
    >
      {
        projects.map((project) => (
          <li>
            <PortfolioCard {...project} />
          </li>
        ))
      }
    </ul>

    <!-- CTA -->
    <div class="text-center mt-16">
      <a href="https://drive.google.com/drive/u/0/folders/1vM-UlX7cEwMghoeTfjeUMVKhBNLppfml" class="btn-outline">
        Ver portafolio completo
        <svg
          width="14"
          height="14"
          viewBox="0 0 14 14"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M2 7h10M8 3l4 4-4 4"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>
  </div>
</section>
