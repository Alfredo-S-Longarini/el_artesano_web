---
const explore = [
  { label: 'Portafolio',        href: '#portafolio' },
  { label: 'Proceso',           href: '#proceso' },
  { label: 'Contacto',          href: '#contacto' },
  { label: 'Trabajemos juntos', href: '#contacto' },
];

const social = [
  {
    label: 'Facebook',
    href: 'https://www.facebook.com/elartesanoweb',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>`,
  },
  {
    label: 'Instagram',
    href: 'https://www.instagram.com/elartesanoweb',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>`,
  },
];

const year = new Date().getFullYear();
---

<footer class="bg-brown px-5 sm:px-10 lg:px-20 pt-[clamp(48px,6vw,80px)] pb-[clamp(32px,4vw,48px)]">
  <div class="max-w-content mx-auto">

    <div class="grid grid-cols-1 md:grid-cols-[2fr_1fr_1fr] gap-10 mb-16">

      <!-- Brand -->
      <div>
        <a href="/ruavisual" aria-label="RUA Visual inicio" class="inline-flex">
          <svg width="180" height="34" viewBox="0 0 180 34" fill="none" xmlns="http://www.w3.org/2000/svg">
            <text x="0" y="28" font-family="'Lora', Georgia, serif" font-size="32" font-weight="600" fill="#f4f1ea" letter-spacing="4">RUA</text>
            <text x="78" y="18" font-family="'Montserrat', sans-serif" font-size="8" font-weight="400" fill="#c89f53" letter-spacing="1.5">VISUAL</text>
            <text x="78" y="29" font-family="'Montserrat', sans-serif" font-size="6.5" font-weight="300" fill="rgba(244,241,234,0.4)" letter-spacing="0.8">by El Artesano Web</text>
          </svg>
        </a>
        <p class="font-sans text-[13px] leading-[1.8] text-cream/40 mt-5 max-w-[300px]">
          Diseño gráfico artesanal para marcas que quieren comunicar con identidad.
          Argentina · Costa Rica.
        </p>
      </div>

      <!-- Explorar nav -->
      <nav aria-label="Explorar">
        <p class="font-sans text-[11px] font-semibold tracking-[2px] uppercase text-gold/70 mb-5">Explorar</p>
        <ul class="list-none flex flex-col gap-2.5">
          {explore.map(({ label, href }) => (
            <li>
              <a href={href} class="font-sans text-[13px] text-cream/40 no-underline hover:text-cream/85 transition-colors duration-200">
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Redes Sociales -->
      <nav aria-label="Redes Sociales">
        <p class="font-sans text-[11px] font-semibold tracking-[2px] uppercase text-gold/70 mb-5">Redes Sociales</p>
        <div class="flex gap-3">
          {social.map(({ label, href, icon }) => (
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={label}
              class="w-10 h-10 rounded-full bg-cream/10 flex items-center justify-center text-cream/50 hover:bg-gold hover:text-brown transition-all duration-300"
              set:html={icon}
            />
          ))}
        </div>
      </nav>

    </div>

    <!-- Bottom bar -->
    <div class="border-t border-cream/[0.08] pt-8 flex flex-wrap justify-between items-center gap-4">
      <p class="font-sans text-[12px] tracking-[0.5px] text-cream/25">
        © {year} RUA Visual · El Artesano Web. Todos los derechos reservados.
      </p>
      <a href="https://elartesanoweb.com"
         target="_blank" rel="noopener noreferrer"
         class="font-sans text-[12px] tracking-[0.5px] text-gold/50 no-underline hover:text-gold/90 transition-colors duration-200">
        elartesanoweb.com
      </a>
    </div>

  </div>
</footer>
