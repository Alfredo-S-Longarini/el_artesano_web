---
// src/components/Navbar.astro
---

<header id="navbar" class="fixed top-0 left-0 right-0 z-100 px-5 sm:px-10 lg:px-20 transition-all duration-300 border-b border-transparent">
  <div class="max-w-content mx-auto flex items-center justify-between h-[76px] transition-all duration-300">

    <!-- Logo -->
    <a href="/ruavisual" class="text-cream flex items-center no-underline" aria-label="RUA Visual inicio">
      <svg width="180" height="34" viewBox="0 0 180 34" fill="none" xmlns="http://www.w3.org/2000/svg">
        <text x="0" y="28" font-family="'Lora', Georgia, serif" font-size="32" font-weight="600" fill="currentColor" letter-spacing="4">RUA</text>
        <text x="78" y="18" font-family="'Montserrat', sans-serif" font-size="8" font-weight="400" fill="#c89f53" letter-spacing="1.5">VISUAL</text>
        <text x="78" y="29" font-family="'Montserrat', sans-serif" font-size="6.5" font-weight="300" fill="currentColor" fill-opacity="0.5" letter-spacing="0.8">by El Artesano Web</text>
      </svg>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-9" aria-label="Navegación principal">
      <a href="#portafolio" class="font-sans text-[13px] font-medium tracking-[1.5px] uppercase text-cream/95 no-underline opacity-80 hover:opacity-100 transition-opacity duration-200">Portafolio</a>
      <a href="#proceso"    class="font-sans text-[13px] font-medium tracking-[1.5px] uppercase text-cream/95 no-underline opacity-80 hover:opacity-100 transition-opacity duration-200">Proceso</a>
      <a href="#contacto"   class="font-sans text-[13px] font-medium tracking-[1.5px] uppercase text-cream/95 no-underline opacity-80 hover:opacity-100 transition-opacity duration-200">Contacto</a>
      <a href="#contacto" class="btn-primary py-2! px-[22px]! text-[12px]!">Trabajemos juntos</a>
    </nav>

    <!-- Hamburger -->
    <button
      id="hamburger-btn"
      class="md:hidden flex flex-col gap-[5px] bg-transparent border-none cursor-pointer p-2"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="block w-6 h-0.5 bg-cream transition-all duration-300 origin-center"></span>
      <span class="block w-6 h-0.5 bg-cream transition-all duration-300 origin-center"></span>
      <span class="block w-6 h-0.5 bg-cream transition-all duration-300 origin-center"></span>
    </button>
  </div>
</header>

<!-- Mobile menu -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-110 bg-cream flex flex-col justify-center items-center gap-10
         translate-x-full transition-transform duration-400 ease-[cubic-bezier(0.77,0,0.18,1)]"
  aria-hidden="true"
>
  <!-- Close button -->
  <button
    id="close-menu-btn"
    class="absolute top-6 right-5 sm:right-10 p-2 bg-transparent border-none cursor-pointer text-brown"
    aria-label="Cerrar menú"
  >
    <svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
      <line x1="6" y1="6" x2="22" y2="22"/>
      <line x1="22" y1="6" x2="6" y2="22"/>
    </svg>
  </button>

  <nav class="flex flex-col items-center gap-10" aria-label="Menú móvil">
    <a href="#portafolio" class="font-serif text-[42px] font-normal text-brown no-underline tracking-[2px] hover:text-gold transition-colors">Portafolio</a>
    <a href="#proceso"    class="font-serif text-[42px] font-normal text-brown no-underline tracking-[2px] hover:text-gold transition-colors">Proceso</a>
    <a href="#contacto"   class="font-serif text-[42px] font-normal text-brown no-underline tracking-[2px] hover:text-gold transition-colors">Contacto</a>
    <a href="#contacto" class="btn-primary mt-4 py-3.5! px-10! text-[13px]!">Trabajemos juntos</a>
  </nav>
</div>

<script>
  const navbar   = document.getElementById('navbar')!;
  const btn      = document.getElementById('hamburger-btn')!;
  const menu     = document.getElementById('mobile-menu')!;
  const closeBtn = document.getElementById('close-menu-btn')!;
  const spans    = btn.querySelectorAll<HTMLElement>('span');

  // Scroll shrink + color transitions
  const logo     = navbar.querySelector<HTMLAnchorElement>('a[aria-label="RUA Visual inicio"]')!;
  const navLinks = navbar.querySelectorAll<HTMLAnchorElement>('nav a:not([class*="btn-"])');

  window.addEventListener('scroll', () => {
    const scrolled = window.scrollY > 40;
    navbar.classList.toggle('bg-cream/95',     scrolled);
    navbar.classList.toggle('backdrop-blur-md', scrolled);
    navbar.classList.toggle('border-beige/60',  scrolled);
    navbar.querySelector('.max-w-content')
      ?.classList.toggle('!h-[60px]', scrolled);
    logo.classList.toggle('text-cream', !scrolled);
    logo.classList.toggle('text-brown',  scrolled);
    navLinks.forEach(link => {
      link.classList.toggle('text-cream/95', !scrolled);
      link.classList.toggle('text-brown',     scrolled);
    });
    // Hamburger color: cream on transparent navbar, brown on solid
    spans.forEach(span => {
      span.classList.toggle('bg-cream', !scrolled);
      span.classList.toggle('bg-brown',  scrolled);
    });
  });

  function closeMenu() {
    btn.setAttribute('aria-expanded', 'false');
    menu.setAttribute('aria-hidden', 'true');
    menu.classList.add('translate-x-full');
    document.body.classList.remove('overflow-hidden');
    spans[0].style.transform = '';
    spans[1].style.transform = '';
    spans[1].style.opacity   = '';
    spans[2].style.transform = '';
  }

  // Hamburger toggle
  btn.addEventListener('click', () => {
    const isOpen = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!isOpen));
    menu.setAttribute('aria-hidden', String(isOpen));
    menu.classList.toggle('translate-x-full', isOpen);
    document.body.classList.toggle('overflow-hidden', !isOpen);

    if (!isOpen) {
      spans[0].style.transform = 'translateY(7px) rotate(45deg)';
      spans[1].style.transform = 'scaleX(0)';
      spans[1].style.opacity   = '0';
      spans[2].style.transform = 'translateY(-7px) rotate(-45deg)';
    } else {
      closeMenu();
    }
  });

  closeBtn.addEventListener('click', closeMenu);

  menu.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', closeMenu);
  });
</script>
